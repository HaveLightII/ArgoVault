{
  "manifest_version": 3,
  "name": "ArgoVault",
  "version": "1.0.0",
  "description": "Save website logins to your local ArgoVault profiles.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ArgoVault"
  }
}
